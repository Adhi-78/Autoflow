# Copy this file to .env and fill in real values. Never commit .env to git.

# Random long string, used to sign JWT tokens. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite for now. Swap to a Postgres URL later, e.g.:
# postgresql://user:password@localhost/autoflow
DATABASE_URL=sqlite:///./autoflow.db

# Telegram bot (see README for how to create one — takes 2 minutes)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
